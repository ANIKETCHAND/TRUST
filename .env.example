# ============================================================
# AgentTrust AI Agent Security Platform — Environment Config
# ============================================================
# Copy this file to .env and replace placeholders with secure, generated values.
# NEVER commit the real .env file or production secrets to source control.

# Application Environment (development | staging | production)
ENVIRONMENT=development
DEBUG=true
API_PORT=8080

# Security Keys (Generate with `openssl rand -hex 32` or `python -c "import secrets; print(secrets.token_urlsafe(32))"`)
# In production, SECRET_KEY must be >= 32 characters and cannot be a default placeholder.
SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-string-for-production
ENROLLMENT_SECRET=change-this-to-a-secure-random-32-byte-hex-string-for-enrollment
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Local Development: SQLite
DATABASE_URL=sqlite+aiosqlite:///./agenttrust.db
# Production: PostgreSQL (asyncpg)
# DATABASE_URL=postgresql+asyncpg://agenttrust:your_strong_postgres_password@postgres:5432/agenttrust

# PostgreSQL container settings (when using docker-compose)
POSTGRES_USER=agenttrust
POSTGRES_PASSWORD=your_strong_postgres_password
POSTGRES_DB=agenttrust

# Storage paths
SANDBOX_STORAGE_PATH=./sandbox_storage
QUARANTINE_STORAGE_PATH=./sandbox_storage/quarantine

# CORS Allowed Origins (comma-separated or JSON list)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080

# Open Policy Agent (OPA) Integration (Optional)
OPA_ENABLED=false
OPA_URL=http://localhost:8181/v1/data/agenttrust/authz

# Pipelock AI Agent Security Proxy Sidecar (Optional)
PIPELOCK_ENABLED=false
PIPELOCK_PROXY_URL=http://localhost:8090/v1/inspect

# Malware & Antivirus Scanning (Optional)
CLAMAV_ENABLED=false
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
YARA_ENABLED=false
YARA_RULES_PATH=./yara_rules

# OpenTelemetry Observability (Optional)
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=agenttrust-core

# Platform Subsystems
BROWSER_SHIELD_ENABLED=true
ENDPOINT_CONNECTOR_ENABLED=true
